# Godot 4+ 에디터가 생성하는 임포트 캐시
.godot/

# 빌드 산출물
build/
*.apk
*.aab
*.aar
*.ipa

# Godot 에디터 로컬 설정
export_presets.cfg.local
*.translation

# macOS
.DS_Store

# Claude Code 머신 로컬 설정 (권한 허용 목록 등)
.claude/settings.local.json

# 실제 키·광고 단위 (config/*.cfg.example 만 커밋)
config/*.cfg

