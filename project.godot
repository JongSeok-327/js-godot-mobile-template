; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="MobileGame Template"
config/version="0.1.0"
run/main_scene="res://scenes/boot/boot.tscn"
config/quit_on_go_back=false
config/icon="res://icon.svg"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.08, 0.08, 0.1, 1)
boot_splash/show_image=false
boot_splash/image="res://assets/icon/splash_blank.png"

[audio]

buses/default_bus_layout="res://assets/audio/default_bus_layout.tres"

[autoload]

EventBus="*res://autoload/event_bus.gd"
SaveManager="*res://autoload/save_manager.gd"
Settings="*res://autoload/settings.gd"
AudioManager="*res://autoload/audio_manager.gd"
UiSounds="*res://autoload/ui_sounds.gd"
SceneManager="*res://autoload/scene_manager.tscn"
Services="*res://autoload/services.gd"
DebugTools="*res://autoload/debug_tools.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom="res://ui/theme/default_theme.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true

[internationalization]

locale/translations=PackedStringArray("res://locale/translations.en.translation", "res://locale/translations.ko.translation", "res://locale/translations.ja.translation")

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
